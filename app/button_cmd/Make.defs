ifneq ($(CONFIG_AIC_BUTTON_CMD),)
BUTTON_CMD_DIR := $(APPDIR)/../$(CONTEST_PROJECT)/app/button_cmd
BUTTON_CMD_FRAMEWORK_DIR := $(APPDIR)/../$(CONTEST_PROJECT)/framework

CONFIGURED_APPS += $(BUTTON_CMD_DIR)

CFLAGS += ${INCDIR_PREFIX}$(BUTTON_CMD_FRAMEWORK_DIR)/include
CXXFLAGS += ${INCDIR_PREFIX}$(BUTTON_CMD_FRAMEWORK_DIR)/include
endif
