DRV_SOURCE_PATH=drv
DRV_DMA_PATH=drv/dma

DEPPATH+=--dep-path $(DRV_DMA_PATH) 
VPATH+=:chip/$(DRV_DMA_PATH)

ARCH_DMA_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_DMA_PATH)
ARCH_DMA_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_DMA_SRC_PATH)

# Include the  module.

CHIP_CSRCS += $(DRV_DMA_PATH)/aic_drv_dma.c