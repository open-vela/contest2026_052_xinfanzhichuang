DRV_SOURCE_PATH=drv
DRV_RTC_PATH=drv/rtc

DEPPATH+=--dep-path $(DRV_RTC_PATH) 
VPATH+=:chip/$(DRV_RTC_PATH)

ARCH_RTC_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_RTC_PATH)
ARCH_RTC_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_RTC_SRC_PATH)
# Include the  module.

CHIP_CSRCS += $(DRV_RTC_PATH)/drv_rtc.c
CHIP_CSRCS += $(DRV_RTC_PATH)/rtc_nuttx.c
