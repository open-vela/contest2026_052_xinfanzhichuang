DRV_SOURCE_PATH=drv
DRV_I2C_PATH=drv/i2c

DEPPATH+=--dep-path $(DRV_I2C_PATH) 
VPATH+=:chip/$(DRV_I2C_PATH)

ARCH_I2C_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_I2C_PATH)
ARCH_I2C_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_I2C_SRC_PATH)
# Include the  module.

CHIP_CSRCS += $(DRV_I2C_PATH)/aic_drv_i2c.c

