DRV_SOURCE_PATH=drv
DRV_PWM_PATH=drv/pwm


DEPPATH+=--dep-path $(DRV_PWM_PATH) 
VPATH+=:chip/$(DRV_PWM_PATH)

ARCH_PWM_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_PWM_PATH)
ARCH_PWM_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_PWM_SRC_PATH)

# Include the  module.

CHIP_CSRCS += $(DRV_PWM_PATH)/drv_pwm_nuttx.c