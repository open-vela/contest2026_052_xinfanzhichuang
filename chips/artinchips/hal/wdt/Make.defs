DRV_SOURCE_PATH=hal
WDT_PATH=hal/wdt

DEPPATH+=--dep-path $(WDT_PATH) 
VPATH+=:chip/$(WDT_PATH)

ARCH_WDT_SRC_PATH:=$(AIC_SRCDIR)/$(WDT_PATH)
ARCH_WDT_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_WDT_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(WDT_PATH)/hal_wdt.c
