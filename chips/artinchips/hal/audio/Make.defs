DRV_SOURCE_PATH=hal
AUDIO_PATH=hal/audio

DEPPATH+=--dep-path $(AUDIO_PATH) 
VPATH+=:chip/$(AUDIO_PATH)

ARCH_AUDIO_SRC_PATH:=$(AIC_SRCDIR)/$(AUDIO_PATH)
ARCH_AUDIO_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_AUDIO_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(AUDIO_PATH)/hal_audio.c
