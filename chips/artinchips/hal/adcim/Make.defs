DRV_SOURCE_PATH=hal
ADCIM_PATH=hal/adcim

DEPPATH+=--dep-path $(ADCIM_PATH) 
VPATH+=:chip/$(ADCIM_PATH)

ARCH_ADCIM_SRC_PATH:=$(AIC_SRCDIR)/$(ADCIM_PATH)
ARCH_ADCIM_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_ADCIM_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(ADCIM_PATH)/hal_adcim.c
