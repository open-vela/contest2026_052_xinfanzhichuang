DRV_SOURCE_PATH=hal
HAL_UART_PATH=hal/uart

DEPPATH+=--dep-path $(HAL_UART_PATH) 
VPATH+=:chip/$(HAL_UART_PATH)

ARCH_UART_SRC_PATH:=$(AIC_SRCDIR)/$(HAL_UART_PATH)
ARCH_UART_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_UART_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(HAL_UART_PATH)/aic_hal_uart.c
