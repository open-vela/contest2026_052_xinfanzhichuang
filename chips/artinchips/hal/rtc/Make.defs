DRV_SOURCE_PATH=hal
RTC_PATH=hal/rtc

DEPPATH+=--dep-path $(RTC_PATH) 
VPATH+=:chip/$(RTC_PATH)

ARCH_RTC_SRC_PATH:=$(AIC_SRCDIR)/$(RTC_PATH)
ARCH_RTC_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_RTC_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(RTC_PATH)/hal_rtc.c
