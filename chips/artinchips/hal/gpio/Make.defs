DRV_SOURCE_PATH=hal
GPIO_PATH=hal/gpio

DEPPATH+=--dep-path $(GPIO_PATH) 
VPATH+=:chip/$(GPIO_PATH)

ARCH_GPIO_SRC_PATH:=$(AIC_SRCDIR)/$(GPIO_PATH)
ARCH_GPIO_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_GPIO_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(GPIO_PATH)/aic_hal_gpio.c
