DRV_SOURCE_PATH=hal
HAL_PWM_PATH=hal/pwm

DEPPATH+=--dep-path $(HAL_PWM_PATH) 
VPATH+=:chip/$(HAL_PWM_PATH)

ARCH_DISPLAY_SRC_PATH:=$(AIC_SRCDIR)/$(HAL_PWM_PATH)
ARCH_DISPLAY_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_DISPLAY_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(HAL_PWM_PATH)/hal_pwm.c

