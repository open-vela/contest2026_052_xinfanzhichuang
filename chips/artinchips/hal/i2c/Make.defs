DRV_SOURCE_PATH=hal
HAL_I2C_PATH=hal/i2c

DEPPATH+=--dep-path $(HAL_I2C_PATH) 
VPATH+=:chip/$(HAL_I2C_PATH)

ARCH_I2C_SRC_PATH:=$(AIC_SRCDIR)/$(HAL_I2C_PATH)
ARCH_I2C_PARENT_SRC_PATH:=$(AIC_SRCDIR)/$(DRV_SOURCE_PATH)

CFLAGS += ${INCDIR_PREFIX}$(ARCH_I2C_SRC_PATH)

# Include the  module.
CHIP_CSRCS += $(HAL_I2C_PATH)/hal_i2c.c
