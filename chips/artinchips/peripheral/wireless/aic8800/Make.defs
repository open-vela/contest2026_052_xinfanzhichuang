#
# AIC8800 WiFi Driver for NuttX/Vela
#

DRV_SOURCE_PATH=peripheral
PER_WIFI_PATH=peripheral/wireless/aic8800
PER_WIFI_PLAT_PATH=$(PER_WIFI_PATH)/platform
PER_WIFI_FDRV_PATH=$(PER_WIFI_PATH)/fdrv
PER_WIFI_WPAS_PATH=$(PER_WIFI_PATH)/wpas

DEPPATH+=--dep-path $(PER_WIFI_PLAT_PATH)
DEPPATH+=--dep-path $(PER_WIFI_FDRV_PATH)
DEPPATH+=--dep-path $(PER_WIFI_WPAS_PATH)
VPATH+=:chip/$(PER_WIFI_PLAT_PATH)
VPATH+=:chip/$(PER_WIFI_FDRV_PATH)
VPATH+=:chip/$(PER_WIFI_WPAS_PATH)

ARCH_WIFI_SRC_PATH:=$(AIC_SRCDIR)/$(PER_WIFI_PATH)
ARCH_WIFI_PLAT_SRC_PATH:=$(AIC_SRCDIR)/$(PER_WIFI_PLAT_PATH)
ARCH_WIFI_FDRV_SRC_PATH:=$(AIC_SRCDIR)/$(PER_WIFI_FDRV_PATH)
ARCH_WIFI_WPAS_SRC_PATH:=$(AIC_SRCDIR)/$(PER_WIFI_WPAS_PATH)
ARCH_WIFI_DRV_SRC_PATH:=$(AIC_SRCDIR)/$(PER_WIFI_PATH)/host/driver

CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_PLAT_SRC_PATH)
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_PLAT_SRC_PATH)/netif
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_PLAT_SRC_PATH)/rtos
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_PLAT_SRC_PATH)/wifi
