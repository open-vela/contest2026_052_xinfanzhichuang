CHIP_CSRCS += $(PER_WIFI_WPAS_PATH)/src/utils/eloop.c
CHIP_CSRCS += $(PER_WIFI_WPAS_PATH)/src/utils/ip_addr.c
CHIP_CSRCS += $(PER_WIFI_WPAS_PATH)/src/utils/uuid.c
