CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_PLAT_SRC_PATH)/utils/inc
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_SRC_PATH)/config
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_DRV_SRC_PATH)/drv_fhost
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_DRV_SRC_PATH)/drv_wifi
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_DRV_SRC_PATH)/drv_wlan
