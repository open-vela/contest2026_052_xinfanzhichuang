CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_FDRV_SRC_PATH)/macif
CFLAGS += ${INCDIR_PREFIX}$(ARCH_WIFI_FDRV_SRC_PATH)/aicbt_bsp
