CHIP_CSRCS += $(PER_WIFI_WPAS_PATH)/wpa_supplicant/wmm_ac.c
CHIP_CSRCS += $(PER_WIFI_WPAS_PATH)/wpa_supplicant/wpa_supplicant.c
CHIP_CSRCS += $(PER_WIFI_WPAS_PATH)/wpa_supplicant/wpas_glue.c






AIC8800_HOST_DIR=$(AIC_SRCDIR)/$(PER_WIFI_PATH)/host
AIC8800_LIB=$(AIC8800_HOST_DIR)/libwlan_aic8800_e907f.a
AIC8800_GEN_DIR=$(AIC8800_HOST_DIR)/.generated
AIC8800_PATCHED_LIB=$(AIC8800_GEN_DIR)/libwlan_aic8800_e907f.a
AIC8800_OBJCOPY=$(CROSSDEV)objcopy

# Prebuilt WiFi host library.  Keep the checked-in archive read-only; the
# symbol-renamed archive is generated under .generated/ and linked from there.
LDFLAGS += -L$(AIC8800_HOST_DIR)
EXTRA_LIBS += $(AIC8800_PATCHED_LIB)

# Link stubs for prebuilt library dependencies
CHIP_CSRCS += $(PER_WIFI_PLAT_PATH)/wifi/wifi_netdev.c
CHIP_CSRCS += $(PER_WIFI_PLAT_PATH)/wifi/wifi_link_stubs.c

# Pre-process: rename libc-conflicting symbols in prebuilt library so our safe
# wrappers (with NULL checks) are used instead.
$(shell \
  mkdir -p "$(AIC8800_GEN_DIR)" && \
  if [ ! -f "$(AIC8800_PATCHED_LIB)" ] || [ "$(AIC8800_LIB)" -nt "$(AIC8800_PATCHED_LIB)" ]; then \
    $(AIC8800_OBJCOPY) \
      --redefine-sym strlen=aic8800_strlen \
      --redefine-sym sprintf=aic8800_sprintf \
      --redefine-sym snprintf=aic8800_snprintf \
      --redefine-sym vsnprintf=aic8800_vsnprintf \
      "$(AIC8800_LIB)" "$(AIC8800_PATCHED_LIB)" 2>/dev/null; \
  fi \
)
